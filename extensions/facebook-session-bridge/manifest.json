{
  "manifest_version": 3,
  "name": "MediaHub Facebook Session Bridge",
  "version": "1.1.0",
  "minimum_chrome_version": "120",
  "description": "Sync the paired Facebook account to local MediaHub. Never accesses passwords.",
  "key": "",
  "permissions": ["cookies", "alarms", "storage"],
  "host_permissions": ["https://www.facebook.com/*", "http://localhost/*"],
  "externally_connectable": { "matches": ["http://localhost/*", "https://localhost/*"] },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html" },
  "incognito": "not_allowed"
}
